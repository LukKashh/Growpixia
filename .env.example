# Supabase Client Configuration (Web & Android)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Edge Functions & Authoritative Server Secrets
# Cryptographically secure HMAC-SHA256 secret (minimum 32 characters, never commit real secret to git)
AUTH_HMAC_SECRET=your_production_hmac_secret_key_minimum_32_characters

# Supabase Admin Service Role (for server-side Edge Functions only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
